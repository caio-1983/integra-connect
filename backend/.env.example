# AI Runtime — copy to .env and fill in real values. Never commit .env.

# Server
PORT=8787
# Required — the server now refuses to boot without it (CORS fails closed, not open).
ALLOWED_ORIGIN=http://localhost:8080

# Rate limiting (anti cost-runaway on the paid OpenAI-backed endpoints). Optional — these are the defaults if unset.
# As rotas /webhooks/* são isentas de propósito: as entregas de Evolution/Meta
# chegam todas de um único IP e se auto-limitariam, perdendo mensagem recebida.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
AGENT_CHAT_RATE_LIMIT_MAX=20

# Swagger UI em /docs e o spec em /docs/json. Publicam a superfície inteira da
# API sem autenticação, então ficam DESLIGADOS quando NODE_ENV=production.
# Ligue explicitamente só se precisar depurar contra o ambiente publicado.
ENABLE_API_DOCS=false

# Auth between the Integra Connect frontend and this backend (NOT the OpenAI key).
# Generate any long random string, e.g.: openssl rand -hex 32
GATEWAY_API_KEY=change-me-dev-key

# Real OpenAI key — kept server-side only, never sent to the browser.
OPENAI_API_KEY=sk-...

# --- Sprint 011: Evolution API (WhatsApp) ---
# Base URL of your Evolution API instance and its global API key (apikey header).
EVOLUTION_API_URL=https://evolution.your-domain.com
EVOLUTION_API_KEY=your-evolution-global-api-key
# Public HTTPS URL of THIS backend, reachable by Evolution to deliver webhooks.
PUBLIC_BASE_URL=https://ai.your-domain.com
# Secret path segment appended to the webhook URL to authenticate inbound posts.
EVOLUTION_WEBHOOK_SECRET=change-me-webhook-secret

# --- Shared inbox: sign outgoing replies with the attendant's name ---
# A shared number carries ONE WhatsApp profile name, so without this every
# attendant reaches the customer under whoever that line belongs to. `off`
# disables signing; anything else (or unset) keeps it on. Only human replies are
# signed, and only on the wire — the stored message keeps the clean text.
OUTBOUND_SIGNATURE=on

# --- Sprint 011: Supabase (service-role — server-side only, bypasses RLS) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Meta: Instagram Direct + Facebook Messenger ---
# Page access token per account, as a JSON map of {"<page-or-ig-account-id>":"<token>"}.
# Tokens are per-page by nature, so a single value would cap the product at one
# account. The keys here are also what the access grants and metadata.instance use.
META_PAGE_TOKENS={"123456789012345":"EAAG..."}
# Token you type into the Meta app's webhook config; the GET handshake compares
# hub.verify_token against it. Without it, Meta cannot validate the webhook.
META_WEBHOOK_VERIFY_TOKEN=change-me-verify-token
# App secret used to verify X-Hub-Signature-256 on every delivery. Optional, but
# WITHOUT IT anyone who learns the callback URL can post fake events.
META_APP_SECRET=your-meta-app-secret
# Optional: separate URL-path secret for the Meta callback. Falls back to
# EVOLUTION_WEBHOOK_SECRET when unset, so a single-secret deploy keeps working.
META_WEBHOOK_SECRET=change-me-meta-webhook-secret

# --- Meta Marketing API: ad id -> campaign / ad set / ad names ---
# System User token (Business Settings > System users) with ads_read on the ad
# accounts, expiration "Never". One token covers every WhatsApp number. Optional:
# without it, ad-sourced leads keep only the raw ad id.
META_ADS_TOKEN=EAAG...
