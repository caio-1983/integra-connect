# Supabase (public anon key — safe to commit, matches the values already in .env)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Backend gateway — a single Fastify server that fronts BOTH the WhatsApp/
# Evolution admin surface AND the AI Runtime (see backend/README.md). This is
# just the frontend→backend base URL. It is NOT an OpenAI/AI provider key —
# connecting WhatsApp needs this and nothing AI-related.
#
# Onde cada valor mora: o docker-compose lê APENAS .env para montar os build
# args, então os valores de PRODUÇÃO ficam lá. .env.local sobrescreve os dois
# com o backend local — o Vite carrega .env e depois .env.local, e sem esse
# override `npm run dev` falaria com a produção e enviaria WhatsApp real.
VITE_BACKEND_URL=http://localhost:8787
# No key: requests carry the signed-in user's Supabase session token, and the
# backend checks role and per-number access itself. VITE_BACKEND_KEY /
# VITE_AI_GATEWAY_KEY are no longer read — anything VITE_* is public in the bundle.
# Legacy alias — still honored as a fallback, but prefer VITE_BACKEND_URL above.
# VITE_AI_GATEWAY_URL=

# Fase de venda da plataforma: 1 = Chat + Operações | 2 = + CRM + IA
VITE_PLATFORM_PHASE=1
